{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker for the whole app (Plan 003): the API under /api and the built
  // web app as static assets, on the same origin.
  "name": "routine-builder",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Do not send Wrangler usage telemetry from this project.
  "send_metrics": false,
  "assets": {
    "directory": "../web/dist",
    // Unknown paths serve index.html so client-side routes like /routines load on refresh.
    "not_found_handling": "single-page-application",
    // API requests always reach the Worker, even page navigations to /api/*.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "routine-builder",
      // Created with `wrangler d1 create routine-builder`. Not a secret: it only works
      // with the account's credentials. Local dev and tests use a local SQLite file.
      "database_id": "fef5bffc-34ea-461b-95cc-fa62a7b3254d",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
