{
  "name": "@routine-builder/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "release": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@routine-builder/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^24.19.4",
    "typescript": "~7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
